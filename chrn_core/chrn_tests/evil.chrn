/*
// chrn if it didn't use sections

let abtest = 3

var varthing1: str
var varthing2: u64

struct Structure {
    field1: i32
    field2: u32
    field3: u64
}

struct varthing1 {}

for Structure {
    cases = ["UpperSnakeCase", "camelCase"]
    field1 {
        // Assuming `self` is going to exist
        override C=>types {self = i32}
    }
    field2 {
        override C=>types {self = f32}
    }
    field3 {
        override C=>types {self = u16}
    }
}

// Could fix this type of issue by just innately separating namespaces to where we still have the same split
// a section would.
for var varthing1 {}

// Nest probably wouldn't exist as a keyword so we'd just default to non-vars
for varthing1 {}

*/
// -- SECTION BASED --

// let abtest = 3

// Says not found in module `evil` because the starting point is the actual module, not the namespace.
// Makes it sound like it didn't search the namespace
// let x = i32::e#3

// {} <- for multiple maybe
// #chrn[MAX_NUM_BITS = 256]

// rm msg for let always inferred
// Memory errors.
// Maybe big float/int isn't the best abstraction for a language.
// Something like a value that's just 256 or a bit higher is maybe better.
// OR could just add a limit for it in the base wrapper that existed before.
//
// We will do a required CLI flag like --allow-arbitrary where it will refuse
// to run the rest of compilation if a > i128(Or just memory budgeted)/f64 value is found.
// OR probably best to have max bits configured as the flag rather than large umbrella.
//
// Both are valid ^^^ you have 18hrs to choose
//
// So bit limit flag and src max limit. Goes to min, maybe warns that the flag given was larger than src
// limit.
//
// Correction: Bit estimation is expensive. Src needs explicit directive to compute them, which THEN forces
// the estimations. By default rejects > i128 & rejects > f64
//
// let float = 2e-1000000000000
import "../chrn_core/chrn_tests/def.chrn"
// let x = def::decimal
let bin = 0b0111
let octal = 0o2
let hex = 0x003
@end
// let decimal_overflow = 9223372036854775808

var->
varthing1: str
varthing2: u64

nest->
struct Structure {
    field1: i32
    field2: u32
    field3: str
}
enum Block {k}

struct varthing1 {}

complex->
override JAVA {
    types { change i32 = java::short }
}
// Should probably maintain the metadata of the option but leave it as an error node of some sort?
// override JAVA { types { opt = 3 } }
for Structure {
    cases = ["UpperSnakeCase", "camelCase"]
    field1 {
        // Assuming `self` is going to exist
        //
        override JAVA=>types{change = java::char}
        override RUST=>types{change = rust::i32}
        // Says is a variable and not a type, but should point to the source where it saw the
        // variable over type. Also should this be public facing where it says it works off preference
        // not separation?
        // override RUST=>types {change x = rust::char}
    }
    field2 {
        // Ok what if it was a question mark? (What is a question mark?)
        override JAVA=>types{change = java::char}
        // Fails because it sees field2 is u32 but numbers are i64 internally.
        // default_val = 3
        // override C=>types {self = f32}
    }
    field3 {
        // override C=>types {self = u16}
    }
}

for nest Block=>k {
    override JAVA=>types{change u32 = java::char}
}

for var varthing1 { override RUST=>types{change = rust::i32} }

for varthing1 {}
