/*
// chrn if it didn't use sections

let abtest = 3

var varthing1: str
var varthing2: u64

struct Structure {
    field1: i32
    field2: u32
    field3: u64
}

struct varthing1 {}

for Structure {
    cases = ["UpperSnakeCase", "camelCase"]
    field1 {
        // Assuming `self` is going to exist
        override C=>types {self = i32}
    }
    field2 {
        override C=>types {self = f32}
    }
    field3 {
        override C=>types {self = u16}
    }
}

// Could fix this type of issue by just innately separating namespaces to where we still have the same split
// a section would.
for var varthing1 {}

// Nest probably wouldn't exist as a keyword so we'd just default to non-vars
for varthing1 {}

*/
// -- SECTION BASED --

// let abtest = 3

// Says not found in module `evil` because the starting point is the actual module, not the namespace.
// Makes it sound like it didn't search the namespace
// let x = i32::e#3

// {} <- for multiple maybe

// What if we had something like i"" where it's like b"" but it's a string with invalid utf-8, so we
// know to ignore it?

// comptime directs & runtime directives distinction?
// Maybe modle finder collects comptime syntax only?
#chrn[MAX_NUMERIC_BITS(256), MAX_THING(2)]

// Thinking about removing the big int usage and just making caps or integers.
// So, we can pick "--max-int-bits=" where the eq value must be a known bit range like 256, 512, etc.
// Floats may stay the same, but the integer part can definitely be less complication, we don't need
// big int for that. Float also needs "--max-float-bits". Or we can keep the numeric version which dictates
// both, while still keeping the specific int/float.
// let float = 2e-1000000000000
import "../chrn_core/chrn_tests/def.chrn"
// let x = def::decimal
// Namespaces like i128::MAX bypass the max bits because they don't check cfg

// Remember me
// let bin = f32::NAN + f32::INF
let octal = 0o2
let hex = 0x003
@end
let decimal_overflow = 9223372036854775808

var->
varthing1: str
varthing2: u64

nest->
struct Structure {
    field1: i32
    field2: u32
    field3: str
}
enum Block {k}

struct varthing1 {}

complex->
override JAVA {
    types { change i32 = java::short }
}
// Should probably maintain the metadata of the option but leave it as an error node of some sort?
// override JAVA { types { opt = 3 } }
for Structure {
    cases = ["UpperSnakeCase", "camelCase"]
    field1 {
        // Assuming `self` is going to exist
        //
        override JAVA=>types{change = java::char}
        override RUST=>types{change = rust::i32}
        // Says is a variable and not a type, but should point to the source where it saw the
        // variable over type. Also should this be public facing where it says it works off preference
        // not separation?
        // override RUST=>types {change x = rust::char}
    }
    field2 {
        // Ok what if it was a question mark? (What is a question mark?)
        override JAVA=>types{change = java::char}
        // Fails because it sees field2 is u32 but numbers are i64 internally.
        // default_val = 3
        // override C=>types {self = f32}
    }
    field3 {
        // override C=>types {self = u16}
    }
}

for nest Block=>k {
    override JAVA=>types{change u32 = java::char}
}

for var varthing1 { override RUST=>types{change = rust::i32} }

for varthing1 {}
